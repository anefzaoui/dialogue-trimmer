{
  "name": "dialogue-trimmer",
  "version": "1.1.0",
  "description": "Cross-platform CLI and library that removes non-dialogue lead-in and tail from video clips with voice activity detection, snaps every cut to the quietest moment, then optionally assembles them.",
  "type": "module",
  "bin": {
    "dialogue-trimmer": "./dialogue-trimmer.js"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "echogarden": "^3.2.0"
  },
  "keywords": [
    "video",
    "audio",
    "vad",
    "voice-activity-detection",
    "ffmpeg",
    "dead-air",
    "video-editing",
    "microdrama",
    "library"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anefzaoui/dialogue-trimmer.git"
  },
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "lib/",
    "dialogue-trimmer.js",
    "README.md",
    "LICENSE"
  ]
}

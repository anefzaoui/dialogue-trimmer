{
  "name": "dialogue-trimmer",
  "version": "1.0.0",
  "description": "Cross-platform CLI that removes non-dialogue lead-in and tail from video clips with voice activity detection, then optionally assembles them.",
  "type": "module",
  "bin": {
    "dialogue-trimmer": "./dialogue-trimmer.js"
  },
  "scripts": {
    "test": "node --check dialogue-trimmer.js && node dialogue-trimmer.js --help"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "echogarden": "^3.2.0"
  },
  "keywords": [
    "video",
    "audio",
    "vad",
    "voice-activity-detection",
    "ffmpeg",
    "dead-air",
    "video-editing",
    "microdrama"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anefzaoui/dialogue-trimmer.git"
  },
  "license": "MIT"
}
